{
  "name": "cool-flower-catcher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "verify": "npm run build",
    "branch:list": "git branch -vv",
    "branch:initial": "git switch backup/initial-mvp",
    "branch:main": "git switch main",
    "branch:festival": "git switch codex/festival-distance-calibration"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
